<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfileActivity">

    <Button
        android:id="@+id/timezoneButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="160dp"
        android:text="Timezone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/languageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="1dp"
        android:onClick="changeActivity"
        android:text="Languages"
        app:layout_constraintEnd_toEndOf="@+id/timezoneButton"
        app:layout_constraintTop_toBottomOf="@+id/timezoneButton" />

    <Button
        android:id="@+id/notificationsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:onClick="changeActivity"
        android:text="Notifications"
        app:layout_constraintStart_toStartOf="@+id/languageButton"
        app:layout_constraintTop_toBottomOf="@+id/languageButton" />

    <Button
        android:id="@+id/caretakerButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="84dp"
        android:onClick="changeActivity"
        android:text="Caretaker Settings"
        app:layout_constraintStart_toStartOf="@+id/notificationsButton"
        app:layout_constraintTop_toBottomOf="@+id/notificationsButton" />

    <Button
        android:id="@+id/homeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="88dp"
        android:onClick="changeActivity"
        android:text="home"
        app:layout_constraintStart_toStartOf="@+id/caretakerButton"
        app:layout_constraintTop_toBottomOf="@+id/caretakerButton" />

</androidx.constraintlayout.widget.ConstraintLayout>