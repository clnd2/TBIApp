<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RemindersActivity">

    <Button
        android:id="@+id/buttonShowReminders"
        android:layout_width="219dp"
        android:layout_height="141dp"
        android:layout_marginTop="140dp"
        android:onClick="showReminders"
        android:text="@string/show_reminders"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/buttonSetReminders"
        android:layout_width="220dp"
        android:layout_height="141dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="114dp"
        android:onClick="setReminders"
        android:text="@string/set_reminders"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonShowReminders"
        app:layout_constraintVertical_bias="0.258" />

    <Button
        android:id="@+id/buttonHome"
        android:layout_width="108dp"
        android:layout_height="58dp"
        android:layout_marginStart="151dp"
        android:layout_marginEnd="152dp"
        android:layout_marginBottom="63dp"
        android:onClick="home"
        android:text="@string/home"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>