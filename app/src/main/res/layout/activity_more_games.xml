<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MoreGames">

    <Button
        android:id="@+id/Sudoku"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:layout_marginTop="132dp"
        android:text="Sudoku"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:onClick="changeActivity" />
    />

    <Button
        android:id="@+id/G2048"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="92dp"
        android:text="2048"
        app:layout_constraintEnd_toEndOf="@+id/WordSearch"
        app:layout_constraintStart_toStartOf="@+id/WordSearch"
        app:layout_constraintTop_toBottomOf="@+id/Sudoku"
        android:onClick="changeActivity" />
    />

    <Button
        android:id="@+id/WordSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="65dp"
        android:layout_marginBottom="255dp"
        android:text="WordSearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:onClick="changeActivity" />

</androidx.constraintlayout.widget.ConstraintLayout>